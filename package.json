{
  "name": "jlpt-n3-vocab-static",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run extract && npm run annotate && vite",
    "extract": "node scripts/extract-content.mjs && node scripts/import-exercises.mjs",
    "annotate": "node scripts/add-readings.mjs",
    "build": "npm run extract && npm run annotate && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@vitejs/plugin-react": "latest",
    "async": "^3.2.6",
    "firebase": "^12.19.0",
    "kuromoji": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
